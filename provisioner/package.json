{
  "name": "heimcloud-credentials-provisioner",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Claim shop provisioning jobs; private Gitea customers/<repo_slug> repos + read-only Neo deploy keys",
  "bin": {
    "heimcloud-credentials-provisioner": "./run.mjs",
    "heimcloud-attach-key": "./attach-key.mjs",
    "heimcloud-sync-deploy-keys": "./sync-deploy-keys.mjs"
  },
  "scripts": {
    "once": "node run.mjs --once",
    "dry-run": "node run.mjs --once --dry-run",
    "attach-key": "node attach-key.mjs",
    "sync-deploy-keys": "node sync-deploy-keys.mjs --from-jobs --once"
  },
  "engines": {
    "node": ">=20"
  }
}
